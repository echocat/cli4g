# Pin the actual PowerShell host independently of the Alpine Bash/Nu environment.
# The runner selects a pinned Azure Linux image on arm64; Microsoft's Ubuntu image is amd64-only.
ARG POWERSHELL_IMAGE=mcr.microsoft.com/powershell:7.5-ubuntu-24.04@sha256:042240d57ec9e47e511033b92625a8d95875ee5860af3015992c248b58a8be81
FROM ${POWERSHELL_IMAGE}
COPY fixture-initial fixture-updated /opt/fixtures/
COPY shell-e2e /opt/tests/shell-e2e
RUN pwsh -NoLogo -NoProfile -Command '$PSVersionTable.PSVersion.ToString()'
ENTRYPOINT ["/opt/tests/shell-e2e", "-test.v", "-test.run=^TestContainerPowerShellCompletion$", "-test.timeout=2m"]
